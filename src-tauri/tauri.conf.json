{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Snake",
  "version": "0.4.0",
  "identifier": "com.agentsnake.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agent Snake",
        "width": 420,
        "height": 520,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "focus": false,
        "shadow": false,
        "skipTaskbar": true,
        "center": true
      },
      {
        "label": "launcher",
        "title": "Snake companion",
        "url": "index.html?launcher",
        "width": 112,
        "height": 112,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "focus": false,
        "shadow": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "focusable": false,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.icns"
    ],
    "shortDescription": "A quiet Snake companion while your agent works"
  }
}
